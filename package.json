{
  "name": "subnet",
  "version": "1.0.0",
  "description": "Zero-cloud LAN chat and file sharing, entirely in the terminal",
  "type": "module",
  "bin": {
    "subnet": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
